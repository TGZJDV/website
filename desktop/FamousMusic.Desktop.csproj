<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TGZJDV's Music —— Windows 桌面客户端（WinUI 3 / Windows App SDK）
    ============================================================================
    本机没有 WinUI 项目模板，本 csproj 是手写的。两个关键点（踩过的坑，别删）：

    1) WindowsPackageType=None + WindowsAppSDKSelfContained=true
       - None：不打 MSIX 包，直接产出可双击的 exe，省掉签名/证书/安装步骤。
       - SelfContained=true：把 Windows App SDK 运行时随程序复制到输出目录。
         本机只注册了 WindowsAppRuntime 1.3/1.4/1.5/1.7/1.8，**没有 1.6**；
         如果 SelfContained=false，非打包 exe 启动时会直接弹
         “FamousMusic.exe - This application could not be started”。
         开启后输出目录自带 Microsoft.WindowsAppRuntime*.dll，任何 Win10/11 x64 都能跑。

    2) AppxMSBuildToolsPath（见下方 PropertyGroup）
       `dotnet build` 用的 .NET SDK 里没有 AppxPackage 的 MSBuild 任务
       （Microsoft.Build.Packaging.Pri.Tasks.dll / Microsoft.Build.AppxPackage.dll
        只随 Visual Studio 提供），WindowsAppSDK 的 MrtCore.PriGen.targets
       会因此报 MSB4062 / 或者拼出 "...\AppxPackageMicrosoft.Build.AppxPackage.dll"。
       所以这里探测本机 VS 的 AppxPackage 目录并指过去。
       注意结尾必须带反斜杠（targets 内部是字符串拼接，不是 Path.Combine）。

    3) XAML 编译器注意：_logs/ 下的草稿 .xaml 会被 SDK 默认 glob 当成 XamlPage
       收进编译（XamlCompiler 会静默 exit 1，不给任何错误信息）。下面用
       <Page Remove="_logs\**" /> 之类把它排除掉。
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <!-- self-contained WinAppSDK 要求显式架构，否则报
         "WindowsAppSDKSelfContained requires a supported Windows architecture." -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>

    <RootNamespace>FamousMusic.Desktop</RootNamespace>
    <AssemblyName>FamousMusic</AssemblyName>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultLanguage>zh-CN</DefaultLanguage>
  </PropertyGroup>

  <!-- 见文件头注释 (2)：为 dotnet build 补上 VS 才有的 AppxPackage MSBuild 任务目录 -->
  <PropertyGroup>
    <!-- 想换机器编译：改下面这个路径，或设置环境变量 AppxMSBuildToolsPath 覆盖 -->
    <_VsAppxProbePath Condition="'$(_VsAppxProbePath)' == ''">G:\visualstudio2026\MSBuild\Microsoft\VisualStudio\v18.0\AppxPackage</_VsAppxProbePath>
    <AppxMSBuildToolsPath Condition="'$(AppxMSBuildToolsPath)' == '' AND Exists('$(_VsAppxProbePath)\Microsoft.Build.Packaging.Pri.Tasks.dll')">$(_VsAppxProbePath)\</AppxMSBuildToolsPath>
  </PropertyGroup>

  <!-- 见文件头注释 (3)：把 _logs 等草稿目录挡在 XAML/编译 glob 之外 -->
  <ItemGroup>
    <Page Remove="_logs\**" />
    <None Remove="_logs\**" />
    <Compile Remove="_logs\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.*" />
  </ItemGroup>

</Project>
