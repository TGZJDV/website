<?xml version="1.0" encoding="utf-8"?>
<!--
    Pages/MePage.xaml —— 我的页（登录 / 退出 + 我的收藏）
    控件：TextBox + PasswordBox + Button + ProgressRing + InfoBar + ListView
    登录卡片与收藏列表分别用 Visibility 切换。
-->
<local:PageBase
    x:Class="FamousMusic.Desktop.Pages.MePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:FamousMusic.Desktop.Pages"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,18" Spacing="16">

            <StackPanel Spacing="4">
                <TextBlock Text="我的" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="账号、收藏与本地状态" Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>

            <InfoBar x:Name="Info" IsOpen="False" IsClosable="True" />

            <!-- ============ 登录卡片（未登录） ============ -->
            <Border x:Name="LoginCard"
                    Style="{StaticResource PanelCardBorderStyle}"
                    Padding="20">
                <StackPanel Spacing="10" MaxWidth="380" HorizontalAlignment="Left">
                    <TextBlock Text="登录 TGZJDV's Music" Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock Text="账号与网站 / Android 版通用"
                               FontSize="12" Foreground="{StaticResource AppMutedBrush}" />

                    <TextBox x:Name="EmailBox" PlaceholderText="邮箱"
                             Height="40" FontSize="14"
                             VerticalContentAlignment="Center" />

                    <PasswordBox x:Name="PasswordBox" PlaceholderText="密码"
                                 Height="40" FontSize="14"
                                 VerticalContentAlignment="Center"
                                 KeyDown="PasswordBox_KeyDown" />

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="LoginButton"
                                Style="{StaticResource PillPrimaryButtonStyle}"
                                Click="LoginButton_Click"
                                ToolTipService.ToolTip="登录">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72E;" FontSize="13" Foreground="White" />
                                <TextBlock Text="登录" FontSize="12.5" FontWeight="SemiBold" Foreground="White" />
                            </StackPanel>
                        </Button>
                        <ProgressRing x:Name="LoginBusy" IsActive="False"
                                      Width="18" Height="18"
                                      Foreground="{StaticResource AppPrimaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ 已登录卡片 ============ -->
            <Border x:Name="UserCard"
                    Style="{StaticResource PanelCardBorderStyle}"
                    Padding="18"
                    Visibility="Collapsed">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="56" Height="56" CornerRadius="28"
                            Background="{StaticResource AppPrimaryBrush}">
                        <TextBlock x:Name="AvatarText" Text="?"
                                   FontSize="22" FontWeight="SemiBold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="UserName" Style="{StaticResource SectionTitleTextStyle}" FontSize="18" />
                        <TextBlock x:Name="UserEmail" FontSize="12.5"
                                   Foreground="{StaticResource AppMutedBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="UserTitle" FontSize="11.5"
                                   Foreground="{StaticResource AppMutedBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Button Grid.Column="2" x:Name="LogoutButton"
                            Style="{StaticResource PillButtonStyle}"
                            VerticalAlignment="Center"
                            Click="LogoutButton_Click"
                            ToolTipService.ToolTip="退出登录">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7E8;" FontSize="13" Foreground="{StaticResource AppTextBrush}" />
                            <TextBlock Text="退出登录" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource AppTextBrush}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ============ 收藏 ============ -->
            <TextBlock x:Name="StatusText" Style="{StaticResource StatusTextStyle}" />

            <StackPanel x:Name="LoadingPanel" Orientation="Horizontal" Spacing="10"
                        HorizontalAlignment="Center" Margin="0,24,0,24" Visibility="Collapsed">
                <ProgressRing IsActive="True" Width="18" Height="18"
                              Foreground="{StaticResource AppPrimaryBrush}" />
                <TextBlock Text="加载中…" FontSize="12.5" Foreground="{StaticResource AppMutedBrush}" />
            </StackPanel>

            <StackPanel x:Name="FavoritesHeader" Orientation="Horizontal" Spacing="12"
                        Margin="0,6,0,6" Visibility="Collapsed">
                <TextBlock x:Name="FavoritesTitle" Style="{StaticResource SectionTitleTextStyle}"
                           VerticalAlignment="Center" />
                <Button x:Name="FavoritesPlayAll"
                        Style="{StaticResource PillPrimaryButtonStyle}"
                        Click="FavoritesPlayAll_Click"
                        ToolTipService.ToolTip="播放全部收藏">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE768;" FontSize="13" Foreground="White" />
                        <TextBlock Text="播放全部" FontSize="12.5" FontWeight="SemiBold" Foreground="White" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <ListView x:Name="FavoritesList"
                      ItemTemplate="{StaticResource SongRowTemplate}"
                      ItemContainerStyle="{StaticResource SongListViewItemStyle}"
                      SelectionMode="None"
                      IsItemClickEnabled="False"
                      Padding="0"
                      Background="Transparent" />
        </StackPanel>
    </ScrollViewer>
</local:PageBase>
