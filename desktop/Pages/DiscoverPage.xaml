<?xml version="1.0" encoding="utf-8"?>
<!--
    Pages/DiscoverPage.xaml —— 发现页
    控件：ScrollViewer + GridView(歌曲网格) + InfoBar + 胶囊按钮
    歌曲卡片由 Styles/Templates.xaml 的 SongCardTemplate 渲染。
-->
<local:PageBase
    x:Class="FamousMusic.Desktop.Pages.DiscoverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:FamousMusic.Desktop.Pages"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,18" Spacing="18">

            <!-- 标题 + 操作按钮 -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="发现音乐" Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock Text="TGZJDV's Music · 全部曲库" Style="{StaticResource PageSubtitleTextStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <Button x:Name="PlayAllButton"
                            Style="{StaticResource PillPrimaryButtonStyle}"
                            Click="PlayAllButton_Click"
                            ToolTipService.ToolTip="从第一首开始播放">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE768;" FontSize="13" Foreground="White" />
                            <TextBlock Text="播放全部" FontSize="12.5" FontWeight="SemiBold" Foreground="White" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ShuffleButton"
                            Style="{StaticResource PillButtonStyle}"
                            Click="ShuffleButton_Click"
                            ToolTipService.ToolTip="随机播放一首">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8B1;" FontSize="13" Foreground="{StaticResource AppTextBrush}" />
                            <TextBlock Text="随机播放" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource AppTextBrush}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RefreshButton"
                            Style="{StaticResource PillButtonStyle}"
                            Click="RefreshButton_Click"
                            ToolTipService.ToolTip="重新拉取曲库">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="13" Foreground="{StaticResource AppTextBrush}" />
                            <TextBlock Text="刷新" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource AppTextBrush}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <InfoBar x:Name="Info" IsOpen="False" IsClosable="True" />

            <TextBlock x:Name="StatusText" Style="{StaticResource StatusTextStyle}" />

            <!-- 加载中 -->
            <StackPanel x:Name="LoadingPanel" Orientation="Horizontal" Spacing="10"
                        HorizontalAlignment="Center" Margin="0,24,0,24" Visibility="Collapsed">
                <ProgressRing IsActive="True" Width="18" Height="18"
                              Foreground="{StaticResource AppPrimaryBrush}" />
                <TextBlock Text="加载中…" FontSize="12.5" Foreground="{StaticResource AppMutedBrush}" />
            </StackPanel>

            <!-- 歌曲网格：GridView + ItemTemplate（替代旧版手工 WrapPanel） -->
            <GridView x:Name="SongsGrid"
                      ItemTemplate="{StaticResource SongCardTemplate}"
                      ItemContainerStyle="{StaticResource SongGridViewItemStyle}"
                      SelectionMode="None"
                      IsItemClickEnabled="False"
                      Padding="0"
                      Background="Transparent" />
        </StackPanel>
    </ScrollViewer>
</local:PageBase>
