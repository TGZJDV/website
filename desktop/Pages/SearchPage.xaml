<?xml version="1.0" encoding="utf-8"?>
<!--
    Pages/SearchPage.xaml —— 搜索页
    控件：AutoSuggestBox(搜索框) + ListView(结果列表) + InfoBar
    结果行由 SongRowTemplate 渲染。
-->
<local:PageBase
    x:Class="FamousMusic.Desktop.Pages.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:FamousMusic.Desktop.Pages"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,18" Spacing="14">

            <StackPanel Spacing="4">
                <TextBlock Text="搜索" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="输入关键词，回车开始搜索" Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>

            <!-- 搜索框 + 按钮 -->
            <Grid ColumnSpacing="10" Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <AutoSuggestBox x:Name="SearchBox" Grid.Column="0"
                                PlaceholderText="搜索歌曲 / 歌手…"
                                FontSize="14"
                                QueryIcon="Find"
                                QuerySubmitted="SearchBox_QuerySubmitted" />

                <Button Grid.Column="1"
                        Style="{StaticResource PillPrimaryButtonStyle}"
                        Click="SearchButton_Click"
                        ToolTipService.ToolTip="搜索">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE721;" FontSize="13" Foreground="White" />
                        <TextBlock Text="搜索" FontSize="12.5" FontWeight="SemiBold" Foreground="White" />
                    </StackPanel>
                </Button>
            </Grid>

            <InfoBar x:Name="Info" IsOpen="False" IsClosable="True" />

            <TextBlock x:Name="StatusText" Style="{StaticResource StatusTextStyle}" />

            <StackPanel x:Name="LoadingPanel" Orientation="Horizontal" Spacing="10"
                        HorizontalAlignment="Center" Margin="0,24,0,24" Visibility="Collapsed">
                <ProgressRing IsActive="True" Width="18" Height="18"
                              Foreground="{StaticResource AppPrimaryBrush}" />
                <TextBlock Text="搜索中…" FontSize="12.5" Foreground="{StaticResource AppMutedBrush}" />
            </StackPanel>

            <!-- 结果列表 -->
            <ListView x:Name="ResultsList"
                      ItemTemplate="{StaticResource SongRowTemplate}"
                      ItemContainerStyle="{StaticResource SongListViewItemStyle}"
                      SelectionMode="None"
                      IsItemClickEnabled="False"
                      Padding="0"
                      Background="Transparent" />
        </StackPanel>
    </ScrollViewer>
</local:PageBase>
