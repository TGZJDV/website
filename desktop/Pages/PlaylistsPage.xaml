<?xml version="1.0" encoding="utf-8"?>
<!--
    Pages/PlaylistsPage.xaml —— 歌单页
    控件：ListView(歌单列表 / 歌单详情歌曲) + InfoBar + ContentDialog(新建)
    两个视图（列表 / 详情）用 Visibility 切换，都由 DataTemplate 渲染。
-->
<local:PageBase
    x:Class="FamousMusic.Desktop.Pages.PlaylistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:FamousMusic.Desktop.Pages"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,18" Spacing="14">

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="我的歌单" Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock Text="登录后可创建、查看自己的歌单" Style="{StaticResource PageSubtitleTextStyle}" />
                </StackPanel>

                <Button Grid.Column="1" x:Name="CreateButton"
                        Style="{StaticResource PillPrimaryButtonStyle}"
                        VerticalAlignment="Center"
                        Click="CreateButton_Click"
                        ToolTipService.ToolTip="新建一个歌单">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="13" Foreground="White" />
                        <TextBlock Text="新建歌单" FontSize="12.5" FontWeight="SemiBold" Foreground="White" />
                    </StackPanel>
                </Button>
            </Grid>

            <InfoBar x:Name="Info" IsOpen="False" IsClosable="True" />

            <TextBlock x:Name="StatusText" Style="{StaticResource StatusTextStyle}" />

            <StackPanel x:Name="LoadingPanel" Orientation="Horizontal" Spacing="10"
                        HorizontalAlignment="Center" Margin="0,24,0,24" Visibility="Collapsed">
                <ProgressRing IsActive="True" Width="18" Height="18"
                              Foreground="{StaticResource AppPrimaryBrush}" />
                <TextBlock Text="加载中…" FontSize="12.5" Foreground="{StaticResource AppMutedBrush}" />
            </StackPanel>

            <!-- ============ 视图 1：歌单列表 ============ -->
            <ListView x:Name="PlaylistsList"
                      ItemTemplate="{StaticResource PlaylistRowTemplate}"
                      ItemContainerStyle="{StaticResource SongListViewItemStyle}"
                      SelectionMode="None"
                      IsItemClickEnabled="False"
                      Padding="0"
                      Background="Transparent" />

            <!-- ============ 视图 2：歌单详情 ============ -->
            <StackPanel x:Name="DetailPanel" Spacing="8" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Style="{StaticResource PillButtonStyle}"
                            Click="BackToPlaylists_Click"
                            ToolTipService.ToolTip="返回歌单列表">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72B;" FontSize="13" Foreground="{StaticResource AppTextBrush}" />
                            <TextBlock Text="返回歌单列表" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource AppTextBrush}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DetailPlayAllButton"
                            Style="{StaticResource PillPrimaryButtonStyle}"
                            Click="DetailPlayAll_Click"
                            ToolTipService.ToolTip="播放歌单全部歌曲">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE768;" FontSize="13" Foreground="White" />
                            <TextBlock Text="播放全部" FontSize="12.5" FontWeight="SemiBold" Foreground="White" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <TextBlock x:Name="DetailTitle" Style="{StaticResource SectionTitleTextStyle}" />

                <ListView x:Name="DetailSongsList"
                          ItemTemplate="{StaticResource SongRowTemplate}"
                          ItemContainerStyle="{StaticResource SongListViewItemStyle}"
                          SelectionMode="None"
                          IsItemClickEnabled="False"
                          Padding="0"
                          Background="Transparent" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</local:PageBase>
