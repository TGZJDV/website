<?xml version="1.0" encoding="utf-8"?>
<!--
    Styles/Theme.xaml —— 全局资源字典（深色主题）
    ============================================================================
    颜色 / 字体 / 按钮 / 卡片样式全部集中在这里，页面 XAML 只引用主题键，
    不再出现散落的硬编码颜色（旧版这些内容都在 UiKit.cs 里用 C# 硬拼）。

    由 App.xaml 的 MergedDictionaries 合并，因此每个页面在解析 XAML 时就能
    通过 {StaticResource ...} 找到这些键。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================= 调色板 ================= -->
    <!-- 与旧 UiKit.cs 的取色完全一致，保证重构后观感不变 -->

    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FF121212" />
    <SolidColorBrush x:Key="AppSurface2Brush" Color="#FF1E1E1E" />
    <SolidColorBrush x:Key="AppSurface3Brush" Color="#FF2A2A2A" />
    <SolidColorBrush x:Key="AppPlayerBarBrush" Color="#F21A1A1A" />
    <SolidColorBrush x:Key="AppPaneBrush" Color="#E61E1E1E" />

    <SolidColorBrush x:Key="AppPrimaryBrush" Color="#FF0EA5E9" />
    <SolidColorBrush x:Key="AppAccentBrush" Color="#FFE91E63" />

    <SolidColorBrush x:Key="AppTextBrush" Color="#FFF5F5F5" />
    <SolidColorBrush x:Key="AppMutedBrush" Color="#FFA0A0A0" />
    <SolidColorBrush x:Key="AppHairlineBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="AppIconOverlayBrush" Color="#88FFFFFF" />

    <!-- 无封面时的占位渐变（旧 UiKit.CoverFallback） -->
    <LinearGradientBrush x:Key="CoverFallbackBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF1B3B4A" Offset="0" />
        <GradientStop Color="#FF2A2A2A" Offset="0.6" />
        <GradientStop Color="#FF17313D" Offset="1" />
    </LinearGradientBrush>

    <!-- ================= 排版 ================= -->

    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="25" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="PageSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource AppMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="ItemTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="ItemSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource AppMutedBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="StatusTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource AppMutedBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- ================= 按钮 ================= -->

    <!-- 胶囊按钮（旧 UiKit.PillButton，非主色版） -->
    <Style x:Key="PillButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AppSurface3Brush}" />
        <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 胶囊按钮（主色版） -->
    <Style x:Key="PillPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
        <Setter Property="Background" Value="{StaticResource AppPrimaryBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- 播放条上的圆形图标按钮 -->
    <Style x:Key="PlayerIconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="17" />
    </Style>

    <!-- 播放条中央的主播放按钮 -->
    <Style x:Key="PlayCircleButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AppPrimaryBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="19" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- 歌曲卡片（发现页网格）的点击容器 -->
    <Style x:Key="MusicCardButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <!-- 歌曲行 / 歌单行的点击容器 -->
    <Style x:Key="RowButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- 分类胶囊 -->
    <Style x:Key="GenreChipButtonStyle" TargetType="Button">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,8,8" />
    </Style>

    <!-- ================= 卡片容器 ================= -->

    <Style x:Key="PanelCardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AppSurface2Brush}" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>

    <!-- ================= 布局工具 ================= -->
    <!-- WinUI 的 Grid 没有 ColumnSpacing 的隐式默认值，这里给一个可复用的间距样式 -->

    <Style x:Key="GridSpacingStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="12" />
        <Setter Property="RowSpacing" Value="2" />
    </Style>

    <Style x:Key="HeadRowGridStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="12" />
    </Style>

    <!-- ================= 歌曲列表容器 ================= -->
    <!-- 列表项本身不要内边距和最小高度，交给 DataTemplate 里的 Button 控制 -->

    <Style x:Key="SongListViewItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <!-- 歌曲网格项（发现页） -->

    <Style x:Key="SongGridViewItemStyle" TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,4,10" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>

</ResourceDictionary>
