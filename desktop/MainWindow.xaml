<?xml version="1.0" encoding="utf-8"?>
<!--
    MainWindow.xaml —— 主窗口（声明式）
    ============================================================================
    布局全部在这里声明，MainWindow.xaml.cs 只保留：
      * 播放器事件 → 刷新底部播放条
      * NavigationView 选中 → 切换页面实例
      * 窗口尺寸 / Mica 背景

    结构：
      Grid（2 行）
        ├─ NavigationView（左侧导航 + 内容宿主）
        │    ├─ PaneHeader      应用名 / 副标题
        │    ├─ MenuItems       发现 / 搜索 / 分类 / 歌单 / 我的
        │    ├─ PaneFooter      登录状态卡片 + 刷新按钮
        │    └─ Frame(ContentFrame) ← 页面 UserControl 由代码导航进来
        └─ 底部播放条（Border）
-->
<Window
    x:Class="FamousMusic.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="TGZJDV's Music">

    <Grid x:Name="RootGrid" Background="{StaticResource AppSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 主体：NavigationView ==================== -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="0"
            PaneDisplayMode="Left"
            OpenPaneLength="228"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneToggleButtonVisible="True"
            AlwaysShowHeader="False"
            SelectionChanged="NavView_SelectionChanged"
            Background="{StaticResource AppSurfaceBrush}">

            <!-- 导航栏顶部：应用标识 -->
            <NavigationView.PaneHeader>
                <StackPanel Margin="0,6,0,10" Spacing="3">
                    <TextBlock Text="TGZJDV's Music"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource AppTextBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="电脑版 · Windows"
                               FontSize="12"
                               Foreground="{StaticResource AppMutedBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavDiscover" Tag="discover" Content="发现">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavSearch" Tag="search" Content="搜索">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavGenres" Tag="genres" Content="分类">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavPlaylists" Tag="playlists" Content="歌单">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavMe" Tag="me" Content="我的">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- 导航栏底部：登录状态卡片 -->
            <NavigationView.PaneFooter>
                <Grid Margin="0,8,0,10" RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Padding="12" CornerRadius="10"
                            Background="{StaticResource AppSurface3Brush}">
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="NavUserName" Text="未登录"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource AppTextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="NavUserSub" Text="登录后可收藏 / 歌单"
                                       FontSize="12"
                                       Foreground="{StaticResource AppMutedBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <Button Grid.Row="1" x:Name="RefreshMeButton"
                            Content="刷新账号信息"
                            Style="{StaticResource PillButtonStyle}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            FontSize="12"
                            Click="RefreshMeButton_Click"
                            ToolTipService.ToolTip="用本地 token 重新拉取用户信息" />
                </Grid>
            </NavigationView.PaneFooter>

            <!-- 页面宿主 -->
            <Frame x:Name="ContentFrame" IsNavigationStackEnabled="False" Background="Transparent" />
        </NavigationView>

        <!-- ==================== 底部播放条 ==================== -->
        <Border Grid.Row="1"
                Background="{StaticResource AppPlayerBarBrush}"
                BorderBrush="{StaticResource AppHairlineBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,10,16,12">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="190" />
                </Grid.ColumnDefinitions>

                <!-- 左：当前曲目 -->
                <Grid Grid.Column="0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="48" Height="48">
                        <Border x:Name="BarCover"
                                CornerRadius="8"
                                Background="{StaticResource CoverFallbackBrush}">
                            <FontIcon Glyph="&#xE8D6;" FontSize="18"
                                      Foreground="{StaticResource AppMutedBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <!-- 有封面时由代码设置 Background；无封面时保持透明露出渐变 -->
                        <Border x:Name="BarCoverImage" CornerRadius="8" Background="Transparent" />
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock x:Name="BarTitle" Text="未在播放"
                                   FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource AppTextBrush}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        <TextBlock x:Name="BarArtist" Text="选择一首歌开始"
                                   FontSize="12"
                                   Foreground="{StaticResource AppMutedBrush}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </StackPanel>
                </Grid>

                <!-- 中：控制按钮 + 进度 -->
                <Grid Grid.Column="1" RowSpacing="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal"
                                HorizontalAlignment="Center" Spacing="6">
                        <Button Style="{StaticResource PlayerIconButtonStyle}"
                                Click="PreviousButton_Click"
                                ToolTipService.ToolTip="上一首">
                            <FontIcon Glyph="&#xE892;" FontSize="15"
                                      Foreground="{StaticResource AppTextBrush}" />
                        </Button>

                        <Button x:Name="PlayPauseButton"
                                Style="{StaticResource PlayCircleButtonStyle}"
                                Click="PlayPauseButton_Click"
                                ToolTipService.ToolTip="播放 / 暂停">
                            <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="15" Foreground="White" />
                        </Button>

                        <Button Style="{StaticResource PlayerIconButtonStyle}"
                                Click="NextButton_Click"
                                ToolTipService.ToolTip="下一首">
                            <FontIcon Glyph="&#xE893;" FontSize="15"
                                      Foreground="{StaticResource AppTextBrush}" />
                        </Button>

                        <Button x:Name="LoopButton"
                                Style="{StaticResource PlayerIconButtonStyle}"
                                Click="LoopButton_Click"
                                ToolTipService.ToolTip="单曲循环">
                            <FontIcon x:Name="LoopIcon" Glyph="&#xE8EE;" FontSize="15"
                                      Foreground="{StaticResource AppMutedBrush}" />
                        </Button>
                    </StackPanel>

                    <Grid Grid.Row="1" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="PositionText" Grid.Column="0" Text="0:00"
                                   FontSize="12" Foreground="{StaticResource AppMutedBrush}"
                                   VerticalAlignment="Center" />

                        <Slider x:Name="ProgressSlider" Grid.Column="1"
                                Minimum="0" Maximum="1000" Value="0"
                                StepFrequency="1"
                                IsThumbToolTipEnabled="False"
                                VerticalAlignment="Center"
                                ValueChanged="ProgressSlider_ValueChanged"
                                PointerPressed="ProgressSlider_PointerPressed"
                                PointerReleased="ProgressSlider_PointerReleased"
                                PointerCaptureLost="ProgressSlider_PointerCaptureLost" />

                        <TextBlock x:Name="DurationText" Grid.Column="2" Text="0:00"
                                   FontSize="12" Foreground="{StaticResource AppMutedBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Grid>

                <!-- 右：音量 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center" HorizontalAlignment="Right">
                    <FontIcon Glyph="&#xE767;" FontSize="15"
                              Foreground="{StaticResource AppMutedBrush}" />
                    <Slider x:Name="VolumeSlider" Width="112"
                            Minimum="0" Maximum="1" Value="0.85"
                            StepFrequency="0.01"
                            IsThumbToolTipEnabled="False"
                            VerticalAlignment="Center"
                            ValueChanged="VolumeSlider_ValueChanged" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
