# ============================================================
# 复制本文件为 android/keystore.properties 并填入真实值
#   Copy-Item keystore.properties.example keystore.properties
#
# ⚠️ keystore.properties 已在 .gitignore 中，绝不会入库
# ⚠️ keystore 文件 + 这两个密码丢失后，将永远无法更新同包名的 App，
#    请务必将 .jks 文件和密码一起离线备份（密码管理器 / 加密 U 盘）
# ============================================================

# 密钥库文件路径（相对 android/ 目录）
storeFile=keystore/famousmusic-release.jks

# 密钥库密码（你自己设置的）
storePassword=在此填入密钥库密码

# 密钥别名
keyAlias=famousmusic

# 密钥密码（PKCS12 格式下与密钥库密码相同）
keyPassword=在此填入密钥密码
